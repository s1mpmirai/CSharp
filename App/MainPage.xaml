<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FoodStreetAudioGuide"
             xmlns:models="clr-namespace:FoodStreetAudioGuide.Models"
             x:Name="MainPageRoot"
             x:Class="FoodStreetAudioGuide.MainPage"
             x:DataType="local:MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FBFAF7">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,16,16,0" RowSpacing="14">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnPageBackgroundTapped" />
        </Grid.GestureRecognizers>

        <Border Grid.Row="0"
                Padding="18,18,18,16"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#16000000" Offset="0,12" Radius="24" Opacity="0.14" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Grid WidthRequest="44"
                      HeightRequest="44"
                      VerticalOptions="Start">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="←"
                           FontSize="24"
                           TextColor="#8F4208"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Grid>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center">
                    <Label x:Name="PageTitleLabel"
                           Text="Hoa Food Audio"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#A54700" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2"
                                       Spacing="10"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start">
                    <Button x:Name="RefreshDataButton"
                            Text="Refresh"
                            Clicked="OnRefreshDataClicked"
                            IsVisible="False"
                            Padding="12,8"
                            HeightRequest="20"
                            MinimumWidthRequest="80"
                            CornerRadius="12"
                            BackgroundColor="#F6EFE7"
                            TextColor="#8C5A27"
                            FontSize="12"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    <Border WidthRequest="38"
                            HeightRequest="38"
                            BackgroundColor="#F6EFE7"
                            Stroke="#E8D8CA"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Grid x:Name="QrScanLabel"
                              WidthRequest="20"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              RowDefinitions="4,2,4,2,4,2,4"
                              ColumnDefinitions="4,2,4,2,4,2,4">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQrScanTapped" />
                            </Grid.GestureRecognizers>
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Fill" VerticalOptions="Start" />
                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" WidthRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Start" VerticalOptions="Fill" />
                            <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" HeightRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Fill" VerticalOptions="Start" />
                            <Border Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" WidthRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="End" VerticalOptions="Fill" />
                            <Border Grid.Row="5" Grid.Column="0" Grid.RowSpan="2" WidthRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Start" VerticalOptions="Fill" />
                            <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Fill" VerticalOptions="End" />
                            <Border Grid.Row="5" Grid.Column="6" Grid.RowSpan="2" WidthRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="End" VerticalOptions="Fill" />
                            <Border Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="2" HeightRequest="2" BackgroundColor="#151515" StrokeThickness="0" StrokeShape="RoundRectangle 1" HorizontalOptions="Fill" VerticalOptions="End" />

                            <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="#151515" StrokeThickness="0" Padding="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="1" />
                                </Border.StrokeShape>
                                <Border BackgroundColor="Transparent" Stroke="#151515" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="1" />
                                    </Border.StrokeShape>
                                </Border>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="4" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="#151515" StrokeThickness="0" Padding="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="1" />
                                </Border.StrokeShape>
                                <Border BackgroundColor="Transparent" Stroke="#151515" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="1" />
                                    </Border.StrokeShape>
                                </Border>
                            </Border>

                            <Border Grid.Row="4" Grid.Column="1" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="#151515" StrokeThickness="0" Padding="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="1" />
                                </Border.StrokeShape>
                                <Border BackgroundColor="Transparent" Stroke="#151515" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="1" />
                                    </Border.StrokeShape>
                                </Border>
                            </Border>

                            <BoxView Grid.Row="4" Grid.Column="4" Color="#151515" CornerRadius="1" />
                            <BoxView Grid.Row="4" Grid.Column="5" Color="#151515" CornerRadius="1" />
                            <BoxView Grid.Row="5" Grid.Column="4" Color="#151515" CornerRadius="1" />
                            <BoxView Grid.Row="5" Grid.Column="6" Color="#151515" CornerRadius="1" />
                            <BoxView Grid.Row="6" Grid.Column="4" Color="#151515" CornerRadius="1" />
                            <BoxView Grid.Row="6" Grid.Column="5" Color="#151515" CornerRadius="1" />
                        </Grid>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="#F3EFE9"
                Stroke="#E9DED3"
                StrokeThickness="1"
                Padding="2,1"
                HeightRequest="48">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Grid>
                <SearchBar x:Name="SearchBarControl"
                           Placeholder="Search food stalls, cuisines..."
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           PlaceholderColor="#7D8795"
                           TextColor="#1E2433"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <CollectionView x:Name="StallsCollectionView"
                            SelectionMode="None"
                            Margin="0,0,0,0"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StallItem">
                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#E9DED3"
                                StrokeThickness="1"
                                Padding="12,10"
                                MinimumHeightRequest="80">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStallTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow Brush="#14000000" Offset="0,9" Radius="15" Opacity="0.08" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="58,1,62,*" ColumnSpacing="10">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="{Binding DistanceText}"
                                           TextColor="#D87321"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />

                                    <Label x:DataType="local:MainPage"
                                           Text="{Binding Source={x:Reference MainPageRoot}, Path=AwayLabel}"
                                           TextColor="#8C837C"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1"
                                         WidthRequest="1"
                                         HeightRequest="44"
                                         Color="#EFE5DB"
                                         VerticalOptions="Center" />

                                <Border Grid.Column="2"
                                        WidthRequest="62"
                                        HeightRequest="62"
                                        BackgroundColor="#F1ECE5"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="1">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label FormattedText="{Binding HighlightedName}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1D1814"
                                               LineBreakMode="TailTruncation"
                                                HorizontalOptions="Start" />
                                        <Border IsVisible="{Binding HasOfflineAudio}"
                                                BackgroundColor="#ECF8EF"
                                                StrokeThickness="0"
                                                Padding="6,2"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label x:DataType="local:MainPage"
                                                   Text="{Binding Source={x:Reference MainPageRoot}, Path=OfflineBadgeLabel}"
                                                   FontSize="8"
                                                   FontAttributes="Bold"
                                                   TextColor="#2E8F52" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="★" FontSize="11" TextColor="#F1A33A" VerticalOptions="Center" />
                                        <Label Text="{Binding Rating}" FontSize="11" FontAttributes="Bold" TextColor="#2D3544" VerticalOptions="Center" />
                                        <Label Text="{Binding Reviews}" FontSize="11" TextColor="#8B7E73" VerticalOptions="Center" />
                                        <Label Text="•" FontSize="11" TextColor="#CDBEAF" VerticalOptions="Center" />
                                        <Label FormattedText="{Binding HighlightedCuisine}" FontSize="11" TextColor="#8B7E73" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout>
                        <BoxView HeightRequest="4" Opacity="0" />
                        <HorizontalStackLayout x:Name="PoiPaginationBar"
                                               IsVisible="False"
                                               Spacing="6"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Margin="0,0,0,6">
                            <Button x:Name="PoiPrevButton"
                                    Text="«"
                                    Clicked="OnPoiPrevClicked"
                                    Padding="6,3"
                                    MinimumWidthRequest="30"
                                    HeightRequest="26"
                                    CornerRadius="9"
                                    BackgroundColor="#F6EFE7"
                                    TextColor="#8C5A27"
                                    FontSize="11"
                                    FontAttributes="Bold" />

                            <HorizontalStackLayout x:Name="PoiPageNumbersLayout"
                                                   Spacing="4"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />

                            <Button x:Name="PoiNextButton"
                                    Text="»"
                                    Clicked="OnPoiNextClicked"
                                    Padding="6,3"
                                    MinimumWidthRequest="30"
                                    HeightRequest="26"
                                    CornerRadius="9"
                                    BackgroundColor="#F6EFE7"
                                    TextColor="#8C5A27"
                                    FontSize="11"
                                    FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="3" Margin="-16,-4,-16,0" HeightRequest="96">
            <Border VerticalOptions="End"
                    Padding="32,10,32,8"
                    Stroke="#E9D8C8"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="68">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28,28,0,0" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,140,*" VerticalOptions="Center">
                    <Grid WidthRequest="96"
                          HorizontalOptions="Center"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="2">
                        <Label Text="🍴"
                               FontSize="20"
                               HorizontalTextAlignment="Center"
                               TextColor="#EF8F2A" />
                        <Label x:Name="ExploreTabLabel"
                               Grid.Row="1"
                               Text="EXPLORES"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#EF8F2A"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="NoWrap" />
                    </Grid>

                    <Grid Grid.Column="2"
                          WidthRequest="96"
                          HorizontalOptions="Center"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="2">
                        <Label Grid.Row="0"
                               Text="♥"
                               FontSize="20"
                               HorizontalTextAlignment="Center"
                               TextColor="#95A5BE">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavedTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="SavedTabLabel"
                               Grid.Row="1"
                               Text="SAVED"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="#95A5BE"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="NoWrap">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavedTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    x:Name="MapOpenLabel"
                    WidthRequest="74"
                    HeightRequest="74"
                    BackgroundColor="#FFFFFF"
                    Stroke="#F1DDCB"
                    StrokeThickness="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,0,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="37" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,12" Radius="22" Opacity="0.18" />
                </Border.Shadow>
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMapOpenTapped" />
                    </Grid.GestureRecognizers>

                    <Border WidthRequest="56"
                            HeightRequest="56"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#9D4300" Offset="0.0" />
                                <GradientStop Color="#FF8F3F" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M 28,5 C 20.82,5 15,10.82 15,18 C 15,27.75 28,43 28,43 C 28,43 41,27.75 41,18 C 41,10.82 35.18,5 28,5 Z M 28,23 C 25.24,23 23,20.76 23,18 C 23,15.24 25.24,13 28,13 C 30.76,13 33,15.24 33,18 C 33,20.76 30.76,23 28,23 Z"
                              Fill="White"
                              WidthRequest="28"
                              HeightRequest="38"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="InitialLoadingOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#FBFAF7"
              ZIndex="10">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="#EF8F2A"
                                   WidthRequest="36"
                                   HeightRequest="36" />
                <Label Text="Loading nearby stalls..."
                       x:Name="InitialLoadingLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#425066"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="ScriptPopupOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#7A2A1B10"
              ZIndex="20">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border Margin="20"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    MaximumHeightRequest="620"
                    BackgroundColor="White"
                    Stroke="#E8E1DB"
                    StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupCardTapped" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPopupCardTapped" />
                        </Grid.GestureRecognizers>
                        
                        <Label x:Name="ScriptPopupHeaderLabel"
                               Text="Stall Introduction"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#D87321"
                               VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="✕"
                                Clicked="OnClosePopupClicked"
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="18"
                                BackgroundColor="#F6EFE7"
                                TextColor="#8C5A27"
                                FontAttributes="Bold"
                                FontSize="16" />
                    </Grid>

                    <ScrollView x:Name="ScriptPopupScrollView"
                                Grid.Row="1"
                                Margin="0,14,0,0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                            <Label x:Name="ScriptPopupTitleLabel"
                               Grid.Row="0"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#1D1814" />

                        <Border Grid.Row="1"
                                HeightRequest="188"
                                BackgroundColor="#F1ECE5"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Image x:Name="ScriptPopupImage"
                                   Aspect="AspectFill" />
                        </Border>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label x:Name="ScriptPopupCuisineLabel"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1F2738" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="📍" FontSize="14" />
                                    <Label x:Name="ScriptPopupDistanceLabel"
                                           Grid.Column="1"
                                           FontSize="14"
                                           TextColor="#6F655C" />
                                </Grid>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="★" FontSize="14" TextColor="#F1A33A" />
                                    <Label x:Name="ScriptPopupRatingSummaryLabel"
                                           Grid.Column="1"
                                           FontSize="14"
                                           TextColor="#6F655C" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="🕒" FontSize="14" />
                                    <Label x:Name="ScriptPopupHoursLabel"
                                           Grid.Column="1"
                                           FontSize="14"
                                           TextColor="#6F655C" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Grid.Row="3" Spacing="6">
                            <Label x:Name="ScriptPopupRatePromptLabel"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#8C837C" />

                            <HorizontalStackLayout x:Name="ScriptPopupRatingButtons"
                                                   Spacing="6">
                                <Button Text="☆"
                                        Clicked="OnRatePopupClicked"
                                        CommandParameter="1"
                                        Padding="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        TextColor="#F1A33A" />
                                <Button Text="☆"
                                        Clicked="OnRatePopupClicked"
                                        CommandParameter="2"
                                        Padding="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        TextColor="#F1A33A" />
                                <Button Text="☆"
                                        Clicked="OnRatePopupClicked"
                                        CommandParameter="3"
                                        Padding="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        TextColor="#F1A33A" />
                                <Button Text="☆"
                                        Clicked="OnRatePopupClicked"
                                        CommandParameter="4"
                                        Padding="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        TextColor="#F1A33A" />
                                <Button Text="☆"
                                        Clicked="OnRatePopupClicked"
                                        CommandParameter="5"
                                        Padding="0"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        FontSize="24"
                                        BackgroundColor="Transparent"
                                        TextColor="#F1A33A" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="4" Spacing="8">
                            <Label x:Name="ScriptPopupSpecialtiesHeaderLabel"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#8C837C" />

                            <VerticalStackLayout x:Name="ScriptPopupSpecialtiesContainer"
                                                 Spacing="6" />
                        </VerticalStackLayout>

                        <Label Grid.Row="5"
                               Text="Script"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#8490A0" />

                        <Grid Grid.Row="6">
                            <Label x:Name="ScriptPopupContentLabel"
                                   FontSize="16"
                                   LineHeight="1.4"
                                   MaxLines="6"
                                   TextColor="#4C433B" />

                            <BoxView x:Name="ScriptPopupFadeOverlay"
                                     InputTransparent="True"
                                     VerticalOptions="End"
                                     HeightRequest="34"
                                     IsVisible="False">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#FFFFFFFF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>
                        </Grid>

                        <Button x:Name="ScriptPopupReadMoreButton"
                                Grid.Row="7"
                                IsVisible="False"
                                Clicked="OnToggleScriptExpandedClicked"
                                BackgroundColor="Transparent"
                                TextColor="#C8741F"
                                FontAttributes="Bold"
                                HorizontalOptions="Start"
                                Padding="0" />

                        <VerticalStackLayout Grid.Row="8" Spacing="12">
                            <Button x:Name="ScriptPopupCloseButton"
                                    Text="Directions"
                                    Clicked="OnNavigateToStallClicked"
                                    CornerRadius="18"
                                    HeightRequest="48"
                                    BackgroundColor="#EF8F2A"
                                    TextColor="White"
                                    FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label x:Name="ScriptPopupAudioStatusLabel"
                                       VerticalOptions="Center"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#6F655C" />

                                <Button x:Name="ScriptPopupDownloadButton"
                                        Grid.Column="1"
                                        Clicked="OnDownloadAudioClicked"
                                        CornerRadius="16"
                                        HeightRequest="40"
                                        Padding="14,8"
                                        BackgroundColor="#F6EFE7"
                                        TextColor="#C8741F"
                                        FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
