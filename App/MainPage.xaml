<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="MainPageRoot"
             x:Class="FoodStreetAudioGuide.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,14,16,0" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <Label Text="←"
                   FontSize="24"
                   TextColor="#1E2433"
                   VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="PageTitleLabel"
                   Grid.Column="1"
                   Text="Stall List"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="#1E2433" />

            <Label Grid.Column="2"
                   Text="⚚"
                   FontSize="20"
                   TextColor="#1E2433"
                   VerticalOptions="Center"
                   HorizontalOptions="End" />
        </Grid>

        <Border Grid.Row="1"
                BackgroundColor="#EFE9E3"
                StrokeThickness="0"
                Padding="14,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="🔍" FontSize="18" TextColor="#EF8F2A" VerticalOptions="Center" />
                <Label x:Name="SearchHintLabel"
                       Grid.Column="1"
                       Text="Search food stalls, cuisines..."
                       FontSize="18"
                       TextColor="#7D8795"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <CollectionView Grid.Row="2" x:Name="StallsCollectionView" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#FBFBFB"
                            Stroke="#E8E1DB"
                            StrokeThickness="1"
                            Padding="12,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStallTapped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="62,1,66,*" ColumnSpacing="10">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding DistanceText}"
                                       TextColor="#EF8F2A"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />

                                <Label Text="{Binding Source={x:Reference MainPageRoot}, Path=AwayLabel}"
                                       TextColor="#8490A0"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1"
                                     WidthRequest="1"
                                     HeightRequest="44"
                                     Color="#ECE7E2"
                                     VerticalOptions="Center" />

                            <Border Grid.Column="2"
                                    WidthRequest="62"
                                    HeightRequest="62"
                                    BackgroundColor="#E7ECEF"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="31" />
                                </Border.StrokeShape>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="3">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#1F2738"
                                           LineBreakMode="TailTruncation"
                                           HorizontalOptions="StartAndExpand" />
                                    <Border IsVisible="{Binding HasOfflineAudio}"
                                            BackgroundColor="#ECF8EF"
                                            StrokeThickness="0"
                                            Padding="8,3"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="Offline"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#2E8F52" />
                                    </Border>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="★" FontSize="14" TextColor="#F1A33A" VerticalOptions="Center" />
                                    <Label Text="{Binding Rating}" FontSize="14" FontAttributes="Bold" TextColor="#2D3544" VerticalOptions="Center" />
                                    <Label Text="{Binding Reviews}" FontSize="14" TextColor="#8B95A4" VerticalOptions="Center" />
                                    <Label Text="•" FontSize="14" TextColor="#C1C9D4" VerticalOptions="Center" />
                                    <Label Text="{Binding Cuisine}" FontSize="14" TextColor="#8B95A4" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3" Margin="-16,0,-16,0" HeightRequest="96">
            <Border VerticalOptions="End"
                    Padding="32,12,32,10"
                    Stroke="#E9D8C8"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    HeightRequest="72">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,*,*" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="🍴" FontSize="20" HorizontalTextAlignment="Center" TextColor="#EF8F2A" />
                        <Label x:Name="ExploreTabLabel" Text="EXPLORES" FontSize="9" FontAttributes="Bold" TextColor="#EF8F2A" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Grid Grid.Column="1" />

                    <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                        <Image WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavedTapped" />
                            </Image.GestureRecognizers>
                            <Image.Source>
                                <FontImageSource Glyph="&#9829;" Size="20" />
                            </Image.Source>
                        </Image>
                        <Label x:Name="SavedTabLabel" Text="SAVED" FontSize="9" FontAttributes="Bold" TextColor="#95A5BE" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSavedTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border WidthRequest="68"
                    HeightRequest="68"
                    HorizontalOptions="Center"
                    VerticalOptions="Start"
                    TranslationY="-4"
                    BackgroundColor="White"
                    Stroke="#FFFFFF"
                    StrokeThickness="0"
                    ZIndex="5">
                <Border.Shadow>
                    <Shadow Brush="#2BE39A3A" Offset="0,9" Radius="8" Opacity="1.5" />
                </Border.Shadow>

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="34" />
                </Border.StrokeShape>

                <Grid Padding="5">
                    <Border BackgroundColor="#EF9A30"
                            Stroke="#EF9A30"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>

                        <Grid>
                            <Image Source="map.png"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Label x:Name="MapTabLabel" Text="MAP" IsVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ScriptPopupOverlay"
              Grid.RowSpan="4"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPopupBackdropTapped" />
            </Grid.GestureRecognizers>

            <Border Margin="20"
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="420"
                    BackgroundColor="White"
                    Stroke="#E8E1DB"
                    StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupCardTapped" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="14">
                    <Label x:Name="ScriptPopupHeaderLabel"
                           Text="Stall Introduction"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#EF8F2A" />

                    <Label x:Name="ScriptPopupTitleLabel"
                           Grid.Row="1"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1F2738" />

                    <Grid Grid.Row="2" ColumnDefinitions="96,*" ColumnSpacing="14">
                        <Border WidthRequest="96"
                                HeightRequest="96"
                                BackgroundColor="#E7ECEF"
                                StrokeThickness="0"
                                HorizontalOptions="Start"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Image x:Name="ScriptPopupImage"
                                   Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label x:Name="ScriptPopupCuisineLabel"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2738" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="📍" FontSize="14" />
                                <Label x:Name="ScriptPopupDistanceLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       TextColor="#607086" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="★" FontSize="14" TextColor="#F1A33A" />
                                <Label x:Name="ScriptPopupRatingLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       TextColor="#607086" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="💬" FontSize="14" />
                                <Label x:Name="ScriptPopupReviewsLabel"
                                       Grid.Column="1"
                                       FontSize="14"
                                       TextColor="#607086" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Grid.Row="3" Spacing="8">
                        <Label x:Name="ScriptPopupSpecialtiesHeaderLabel"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#8490A0" />

                        <VerticalStackLayout x:Name="ScriptPopupSpecialtiesContainer"
                                             Spacing="6" />
                    </VerticalStackLayout>

                    <Label Grid.Row="4"
                           Text="Script"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#8490A0" />

                    <ScrollView Grid.Row="5" MaximumHeightRequest="220">
                        <Label x:Name="ScriptPopupContentLabel"
                               FontSize="16"
                               LineHeight="1.4"
                               TextColor="#425066" />
                    </ScrollView>

                    <Button x:Name="ScriptPopupCloseButton"
                            Grid.Row="6"
                            Text="Close"
                            Clicked="OnClosePopupClicked"
                            CornerRadius="18"
                            HeightRequest="48"
                            BackgroundColor="#EF8F2A"
                            TextColor="White"
                            FontAttributes="Bold" />

                    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label x:Name="ScriptPopupAudioStatusLabel"
                               VerticalOptions="Center"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#607086" />

                        <Button x:Name="ScriptPopupDownloadButton"
                                Grid.Column="1"
                                Clicked="OnDownloadAudioClicked"
                                CornerRadius="16"
                                HeightRequest="40"
                                Padding="14,8"
                                BackgroundColor="#F6EFE7"
                                TextColor="#C8741F"
                                FontAttributes="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <toolkit:MediaElement x:Name="ScriptAudioPlayer"
                              Grid.RowSpan="4"
                              IsVisible="False"
                              HeightRequest="1"
                              WidthRequest="1"
                              ShouldAutoPlay="False" />
    </Grid>
</ContentPage>
