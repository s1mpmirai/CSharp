<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodStreetAudioGuide.LanguageSelectionPage"
             BackgroundColor="#FBFAF7"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*" BackgroundColor="#FBFAF7">
        <Grid BackgroundColor="#FBFAF7">
            <BoxView WidthRequest="220"
                     HeightRequest="220"
                     CornerRadius="110"
                     Color="#D9F5CB"
                     Opacity="0.55"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="-80,0,0,-90" />
            <BoxView WidthRequest="240"
                     HeightRequest="240"
                     CornerRadius="120"
                     Color="#FFD7B8"
                     Opacity="0.35"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-120,-100,0" />
        </Grid>

        <ScrollView>
            <VerticalStackLayout Padding="22,26,22,18" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Hoa Food Audio"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#A54700"
                               CharacterSpacing="0.4" />
                        <Label x:Name="PageTitleLabel"
                               Text="Select Your Language"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="#1D1814"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Padding="10"
                            BackgroundColor="#FFF7F0"
                            Stroke="#F2E2D0"
                            StrokeThickness="1"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="A"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#A54700"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Border Padding="0"
                        Background="#FFFFFF"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="34" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1F000000" Offset="0,12" Radius="24" Opacity="0.14" />
                    </Border.Shadow>
                    <Grid HeightRequest="190">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF8F0" Offset="0.0" />
                                <GradientStop Color="#F8F3ED" Offset="0.55" />
                                <GradientStop Color="#FFF3E5" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <BoxView WidthRequest="170"
                                 HeightRequest="170"
                                 CornerRadius="85"
                                 Color="#FFE3C8"
                                 Opacity="0.6"
                                 HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="0,-60,-30,0" />

                        <BoxView WidthRequest="150"
                                 HeightRequest="150"
                                 CornerRadius="75"
                                 Color="#DDF5D0"
                                 Opacity="0.55"
                                 HorizontalOptions="Start"
                                 VerticalOptions="End"
                                 Margin="-50,0,0,-55" />

                        <VerticalStackLayout Padding="22" Spacing="12" VerticalOptions="Center">
                            <Border WidthRequest="62"
                                    HeightRequest="62"
                                    Padding="0"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#F3E4D7"
                                    StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9D4300" Offset="0.0" />
                                            <GradientStop Color="#FF8F3F" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <Label Text="A"
                                           FontSize="28"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Global Audio Guide"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#1D1814" />
                                <Label Text="Choose the listening language that fits you best. You can change it later inside the app."
                                       FontSize="15"
                                       TextColor="#7D6E61"
                                       LineHeight="1.35" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label x:Name="RecommendedLabel"
                           Text="Recommended"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1D1814" />
                    <Border Padding="10,4"
                            BackgroundColor="#FFF1E2"
                            Stroke="#F2DDC8"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="999" />
                        </Border.StrokeShape>
                        <Label Text="5 Languages"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#A54700" />
                    </Border>
                </HorizontalStackLayout>

                <Border x:Name="EnglishCard" BackgroundColor="White" Stroke="#EF8F2A" StrokeThickness="2" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="English" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFF2E5" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label x:Name="EnglishFlag" Text="EN" FontSize="16" FontAttributes="Bold" TextColor="#EF8F2A" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="English" FontSize="19" FontAttributes="Bold" TextColor="#1D1814" />
                            <Label Text="United States / United Kingdom" FontSize="14" TextColor="#7D6E61" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Ellipse x:Name="EnglishIndicatorOuter" Fill="#EF8F2A" Stroke="#EF8F2A" />
                            <Ellipse x:Name="EnglishIndicatorInner" Fill="White" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="VietnameseCard" BackgroundColor="#F6F1EB" Stroke="#E5DCD3" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="Tiếng Việt" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label x:Name="VietnameseFlag" Text="VI" FontSize="16" FontAttributes="Bold" TextColor="#5F6877" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Tiếng Việt" FontSize="19" FontAttributes="Bold" TextColor="#1D1814" />
                            <Label Text="Vietnam" FontSize="14" TextColor="#7D6E61" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Ellipse x:Name="VietnameseIndicatorOuter" Fill="Transparent" Stroke="#BBC3D1" />
                            <Ellipse x:Name="VietnameseIndicatorInner" Fill="Transparent" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="ChineseCard" BackgroundColor="#F6F1EB" Stroke="#E5DCD3" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="中文 (Chinese)" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label x:Name="ChineseFlag" Text="ZH" FontSize="16" FontAttributes="Bold" TextColor="#5F6877" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="中文 (Chinese)" FontSize="19" FontAttributes="Bold" TextColor="#1D1814" />
                            <Label Text="Mainland China / Taiwan / Hong Kong" FontSize="14" TextColor="#7D6E61" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Ellipse x:Name="ChineseIndicatorOuter" Fill="Transparent" Stroke="#BBC3D1" />
                            <Ellipse x:Name="ChineseIndicatorInner" Fill="Transparent" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="JapaneseCard" BackgroundColor="#F6F1EB" Stroke="#E5DCD3" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="日本語 (Japanese)" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label x:Name="JapaneseFlag" Text="JA" FontSize="16" FontAttributes="Bold" TextColor="#5F6877" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="日本語 (Japanese)" FontSize="19" FontAttributes="Bold" TextColor="#1D1814" />
                            <Label Text="Japan" FontSize="14" TextColor="#7D6E61" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Ellipse x:Name="JapaneseIndicatorOuter" Fill="Transparent" Stroke="#BBC3D1" />
                            <Ellipse x:Name="JapaneseIndicatorInner" Fill="Transparent" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="KoreanCard" BackgroundColor="#F6F1EB" Stroke="#E5DCD3" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLanguageCardTapped" CommandParameter="한국어 (Korean)" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label x:Name="KoreanFlag" Text="KO" FontSize="16" FontAttributes="Bold" TextColor="#5F6877" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="한국어 (Korean)" FontSize="19" FontAttributes="Bold" TextColor="#1D1814" />
                            <Label Text="South Korea" FontSize="14" TextColor="#7D6E61" />
                        </VerticalStackLayout>
                        <Grid Grid.Column="2" WidthRequest="22" HeightRequest="22" VerticalOptions="Center">
                            <Ellipse x:Name="KoreanIndicatorOuter" Fill="Transparent" Stroke="#BBC3D1" />
                            <Ellipse x:Name="KoreanIndicatorInner" Fill="Transparent" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="ContinueButton"
                        Text="Continue"
                        Clicked="OnContinueClicked"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="20"
                        CornerRadius="26"
                        HeightRequest="56"
                        Margin="0,8,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#9D4300" Offset="0.0" />
                            <GradientStop Color="#FF8F3F" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Label x:Name="ChangeAnytimeLabel"
                       Text="You can change this anytime"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       TextColor="#9A8E84"
                       FontSize="14"
                       Margin="0,0,0,12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
